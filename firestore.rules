rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Professionals Collection
    // - Everyone can read (to search for maestros)
    // - Only the professional themselves can write/update their profile
    match /professionals/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && isOwner(userId);
    }

    // Clients Collection
    // - Only the client themselves can read or write their sensitive data
    match /clients/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // Reservations Collection
    // - Users can read/write if they are the 'clientId' OR 'professionalId' involved in the reservation
    match /reservations/{reservationId} {
      allow read, write: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid || 
        resource.data.professionalId == request.auth.uid ||
        request.resource.data.clientId == request.auth.uid ||
        request.resource.data.professionalId == request.auth.uid
      );
    }
  }
}
